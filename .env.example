# ── Supabase (required for Vercel deployment; optional for local dev) ──────────
#
# LOCAL DEV (default): SQLite is primary. Authentication remains enabled unless the
# explicit development-only opt-out below is set.
# With SUPABASE_URL set locally: writes go to SQLite AND Supabase (dual-write backup).
# On Vercel: set DB_PROVIDER=supabase — skips SQLite, uses Supabase as primary.
#
# Setup:
#   1. Create a free project at https://supabase.com
#   2. Run supabase-schema.sql in the Supabase SQL editor
#   3. Run supabase-rls-migration.sql in the Supabase SQL editor
#   4. Copy the values from Project Settings → API
#
# Server-side (secret — never expose to browser):
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Client-side (safe to expose — needed for login/auth in the browser):
# Must match the same project as SUPABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Set to "supabase" on Vercel (no persistent filesystem for SQLite).
# Leave unset or set to "sqlite" for local development.
DB_PROVIDER=""

SUPABASE_SYNC_USER_ID= # local-dev only: user id used when backing up local SQLite to Supabase

# Development only. Never set this on a shared host or production deployment.
# This opt-out is ignored when NODE_ENV=production.
ALLOW_UNAUTHENTICATED_LOCAL="false"

# Required before saving a signing key. Generate once with:
#   openssl rand -base64 32
# Keep the same value across restarts and backup restores; losing it makes encrypted
# wallet, auto-send, and tiered-reward keys unrecoverable.
SIGNING_KEY_ENCRYPTION_KEY=""

# Production defaults to server-custodied wallet keys. Set true only if you accept
# decrypted signing keys being returned to the authenticated browser for legacy tools.
ALLOW_BROWSER_SIGNING_KEYS="false"

# Mainnet execution is fail-closed. Preview remains available when disabled.
MAINNET_TRANSACTIONS_ENABLED="false"
MAINNET_EMERGENCY_STOP="false"
MAINNET_MAX_XLM_PER_RUN="100"
MAINNET_MAX_XLM_PER_DAY="500"
MAINNET_MAX_OPERATIONS_PER_RUN="100"
# Optional comma-separated G... allowlist. Empty means limits apply to any destination.
MAINNET_ALLOWED_DESTINATIONS=""
# Separate high-entropy HMAC secret for five-minute manual preview approvals.
# Required in production before a mainnet send can be approved.
PREVIEW_APPROVAL_SECRET=""
